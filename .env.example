# Copy to .env and fill in what you need. Every setting is optional.

# Gemini API key (free tier, from aistudio.google.com/apikey). Conversations are written by Gemini.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini calls per day (UTC); after that, built-in scripts until midnight UTC.
# LLM_DAILY_CALLS=400

# Claude API key (paid). Takes priority over Gemini if both are set. Without either, scripted conversations.
ANTHROPIC_API_KEY=

# Weekly LLM budget in US dollars, split into 7 equal daily caps (84 = $12 a day).
LLM_WEEKLY_BUDGET_USD=84

# Postgres connection string. Without it the town is saved to files in ./data.
# DATABASE_URL=postgres://agentville:agentville@localhost:5432/agentville

# 1 = real pace: one sim day every 22.5 minutes, one sim year (28 days) every 10.5 hours.
TIME_SCALE=1

# The seed that builds the town and its people. Change it for a different town.
WORLD_SEED=20261115

# Models: everyday conversations, plans and reactions / reflections and close relationships.
# LLM_ROUTINE_MODEL=claude-haiku-5-5
# LLM_DEEP_MODEL=claude-sonnet-5-5

# PORT=8787
